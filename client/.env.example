# Clerk publishable key — required only when the API runs with DEMO_AUTH=false.
# Find it in the Clerk dashboard under API Keys. It is safe to expose in the
# browser (that is what "publishable" means); never put the secret key here.
VITE_CLERK_PUBLISHABLE_KEY=

# Base URL of the deployed API, including the /api/v1 prefix. Required in
# production (e.g. Vercel) since there is no dev-server proxy there. Leave
# unset locally to use the Vite proxy defined in vite.config.js.
VITE_API_URL=
