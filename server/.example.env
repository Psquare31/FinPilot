PORT=

NODE_ENV=

MONGO_URI=

CLIENT_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=

CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Set to "true" to bypass Clerk and authenticate every request as a fixed
# local demo user (no sign-in). Leave "false" for the real Clerk flow.
DEMO_AUTH=false

# Google Gemini — powers the AI assistant. Without a key the AI endpoints
# return 503 and the UI shows a setup message; the rest of the app is
# unaffected. Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash